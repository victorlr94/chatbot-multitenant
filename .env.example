# =============================================================================
# PLANTILLA DE CONFIGURACIÓN — copiar a .env y ajustar
# NO poner claves reales en este archivo (está bajo control de versiones)
# =============================================================================

# =============================================================================
# LLM — ELIGE UNA DE LAS DOS OPCIONES Y COMENTA LA OTRA
# =============================================================================

# --- OPCIÓN A: modelo cloud (recomendado para producción) ---
#
# 1. Crea una cuenta en https://console.anthropic.com
# 2. Ve a API Keys → Create Key
# 3. Copia la clave (empieza con sk-ant-…) y pégala abajo
#
CHATBOT_LLM_MODEL=anthropic/claude-haiku-4-5-20251001
CHATBOT_LLM_API_BASE=
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Otras opciones cloud (mismos pasos: obtener clave en el sitio del provider):
#   CHATBOT_LLM_MODEL=openai/gpt-4.1-mini   + OPENAI_API_KEY=sk-...
#   CHATBOT_LLM_MODEL=anthropic/claude-opus-4-8  (más capaz, más caro)

# --- OPCIÓN B: modelo local con Ollama (MVP / desarrollo sin costo) ---
#
# Requiere Ollama instalado (https://ollama.com) y el modelo descargado:
#   ollama pull qwen3:8b
#
# CHATBOT_LLM_MODEL=ollama/qwen3:8b
# CHATBOT_LLM_API_BASE=http://localhost:11434
# CHATBOT_LLM_THINK=false

# =============================================================================
# EMBEDDINGS (independiente del LLM principal)
# =============================================================================
# Modelo local con Ollama (sin costo, multilingüe):
CHATBOT_EMBEDDING_MODEL=ollama/bge-m3

# Alternativa cloud:
# CHATBOT_EMBEDDING_MODEL=openai/text-embedding-3-small   + OPENAI_API_KEY=...

# =============================================================================
# TENANT ACTIVO
# =============================================================================
CHATBOT_TENANT=demo_clinica

# =============================================================================
# RETRIEVAL
# =============================================================================
CHATBOT_RETRIEVAL_K=4
CHATBOT_RETRIEVAL_MIN_SCORE=0.35

# =============================================================================
# ALMACENAMIENTO
# =============================================================================
CHATBOT_DB_URL=sqlite:///data/chatbot.db
# Para producción multi-tenant: postgresql://user:pass@host/db
