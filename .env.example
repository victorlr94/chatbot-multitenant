# Copiar a .env y ajustar. Todas las variables usan el prefijo CHATBOT_.

# --- LLM: el swap local <-> cloud es SOLO esto ---
# MVP local (Ollama):
CHATBOT_LLM_MODEL=ollama/llama3.1:8b
CHATBOT_LLM_API_BASE=http://localhost:11434
# Cloud (ejemplos; requieren su API key en el entorno):
#   CHATBOT_LLM_MODEL=anthropic/claude-haiku-4-5-20251001  + ANTHROPIC_API_KEY=...
#   CHATBOT_LLM_MODEL=openai/gpt-4.1-mini                  + OPENAI_API_KEY=...
#   (con modelos cloud, dejar CHATBOT_LLM_API_BASE vacío)

# Embeddings (multilingüe, servido por Ollama en el MVP)
CHATBOT_EMBEDDING_MODEL=ollama/bge-m3

# Tenant activo de esta instalación
CHATBOT_TENANT=demo_clinica

# Retrieval
CHATBOT_RETRIEVAL_K=4
CHATBOT_RETRIEVAL_MIN_SCORE=0.35

# Almacenamiento
CHATBOT_DB_URL=sqlite:///data/chatbot.db
